# Replit configuration. The API serves the built frontend, so the whole app is
# one service on one port -- see SERVE_FRONTEND in backend/config.
run = "npm --prefix backend start"
entrypoint = "backend/server.js"
modules = ["nodejs-22", "postgresql-16"]

[env]
NODE_ENV = "production"
PORT = "5000"
SERVE_FRONTEND = "true"
# DATABASE_URL is provided by the Replit PostgreSQL integration.
# JWT_SECRET, STAFF_INVITE_CODE and the SMTP_* values belong in Secrets,
# never here -- this file is committed.

[nix]
channel = "stable-24_05"

[deployment]
# build runs once per deploy; run starts the service.
build = ["bash", "scripts/replit-build.sh"]
run = ["npm", "--prefix", "backend", "start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

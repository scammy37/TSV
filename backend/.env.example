# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=tsv_db
# Used only when NODE_ENV=test; created automatically by the test runner.
TEST_DB_NAME=tsv_test

# JWT -- required in production, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Shared code required to register a staff or management account. Leave empty
# to disable staff self-registration entirely (homeowners are unaffected).
STAFF_INVITE_CODE=change_me_or_leave_blank

# Email (Gmail SMTP). Leave SMTP_HOST/SMTP_USER blank to run without email:
# notifications are then recorded in email_logs with status 'skipped'.
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@complexmanagement.com

# Application
APP_NAME=TSV - Ticket Management System
# Comma-separated list of allowed origins, or * to allow any.
FRONTEND_URL=http://localhost:3000

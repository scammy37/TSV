# Server
PORT=5000
NODE_ENV=development

# Database -- managed hosts provide DATABASE_URL, which takes precedence over
# the discrete variables below. Set DB_SSL=disable only for a provider that
# does not use TLS.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=tsv_db
# Used only when NODE_ENV=test; created automatically by the test runner.
TEST_DB_NAME=tsv_test

# JWT -- required in production, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Shared code required to register a staff or management account. Leave empty
# to disable staff self-registration entirely (homeowners are unaffected).
STAFF_INVITE_CODE=change_me_or_leave_blank

# ---------------------------------------------------------------------------
# Email. Set one of the two transports, or neither.
#
# With neither, the app runs normally and records what it would have sent in
# email_logs with status 'skipped'. Nothing is delivered and nothing breaks.
# ---------------------------------------------------------------------------

# Option 1 -- over HTTPS. Required on any host that blocks outbound mail ports,
# which includes Render: there, no SMTP settings can work, because the
# connection never opens rather than being refused. Wins over SMTP_* if set.
# MAIL_FROM must be on a domain verified with the provider.
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

# Option 2 -- over SMTP, where those ports are open.
# For Gmail, SMTP_PASS must be an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# Set to true to have the API also serve frontend/build, so the whole app runs
# on one port with no CORS configuration. See docs/DEPLOYMENT.md.
SERVE_FRONTEND=false

# Application
APP_NAME=TSV - Ticket Management System
# Comma-separated list of allowed origins, or * to allow any.
FRONTEND_URL=http://localhost:3000
